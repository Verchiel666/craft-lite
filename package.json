{
  "name": "craft-lite",
  "version": "0.2.0",
  "description": "Clean-room rebuild loop in one small tool: study a page (including its external stylesheets) into evidence, score your rebuild against it. No browser, no dependencies.",
  "type": "module",
  "bin": {
    "craft-lite": "bin/craft-lite.mjs"
  },
  "main": "lib/extract.mjs",
  "files": [
    "bin/",
    "lib/",
    "test/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/selftest.mjs",
    "start": "node bin/craft-lite.mjs"
  },
  "keywords": [
    "clean-room",
    "rebuild",
    "reverse-engineering",
    "design-tokens",
    "similarity",
    "cli",
    "mcp",
    "craft-anything"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Verchiel666/craft-lite.git"
  },
  "homepage": "https://github.com/Verchiel666/craft-lite#readme",
  "bugs": {
    "url": "https://github.com/Verchiel666/craft-lite/issues"
  },
  "author": "Verchiel666"
}
